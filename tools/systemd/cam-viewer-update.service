# Template: create the configured user units through Make; do not install directly.
[Unit]
Description=Update the viewer from deploy/viewer
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=@WORKING_DIRECTORY@
ExecStart=/usr/bin/make --no-print-directory viewer/update @DOCKER_CONTEXT@ @VIEWER_COMPOSE_PROJECT_NAME@ @VIEWER_BIND_HOST@ @VIEWER_PORT@ @VIEWER_PUBLIC_ORIGIN@
TimeoutStartSec=25min
TimeoutStopSec=240s
# Git source is public and must be readable by non-root build containers.
UMask=0022
StandardOutput=journal
StandardError=journal
