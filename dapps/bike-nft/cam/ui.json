{
  "ui": "1.0.0",
  "nodes": {
    "app": {
      "element": "Screen",
      "requires": [
        "view"
      ],
      "props": {
        "title": "Bicycle component registry"
      },
      "children": [
        {
          "element": "Status",
          "props": {
            "label": "Registry paused",
            "value": "$view.paused"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Component token paused",
            "value": "$view.componentTokenPaused"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "The address being viewed selects the available actions. Connecting a wallet changes the viewed address to its connected account. Write actions prepare a transaction for review; send it separately with your wallet and wait for confirmation."
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "$view.viewId",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "entry": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Text",
          "props": {
            "text": "Use the exact serial text for this registry. Case and spaces matter; the contract does not trim or normalize it. Enter a nonempty serial, then choose Look up component to find it or Check registration to check whether it can be registered."
          }
        },
        {
          "element": "Address",
          "props": {
            "label": "Address being viewed",
            "address": "$view.account"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Registrar role",
            "value": "$view.canRegister"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Account info URI is an optional public profile or contact-document location for the account sending the update. Enter an empty value to clear it."
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Account info URI"
          },
          "state": {
            "key": "accountInfo",
            "defaultValue": "$view.accountInfo"
          },
          "enabledWhen": {
            "member": "setAccountInfo",
            "in": "$view.actions"
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "setAccountInfo",
            "args": {
              "view": "$view"
            }
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Serial number to look up"
          },
          "state": {
            "key": "serialNumber",
            "defaultValue": "$view.serialNumber"
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "lookupComponent",
            "args": {
              "view": "$view"
            }
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "openRegister",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "component.empty": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Text",
          "props": {
            "text": "Use the exact serial text for this registry. Case and spaces matter; the contract does not trim or normalize it. Enter a nonempty serial to find or register a component."
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Serial number to look up"
          },
          "state": {
            "key": "serialNumber",
            "defaultValue": "$view.serialNumber"
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "lookupComponent",
            "args": {
              "view": "$view"
            }
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "openRegister",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "component.notFound": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Text",
          "props": {
            "text": "No component is registered for this exact serial in this registry. Check the serial, contract and network before registering."
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Serial number to look up"
          },
          "state": {
            "key": "serialNumber",
            "defaultValue": "$view.serialNumber"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Registered",
            "value": false
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "lookupComponent",
            "args": {
              "view": "$view"
            }
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "openRegister",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "component.found": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Status",
          "props": {
            "label": "Loaded component serial",
            "value": "$view.serialNumber"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Component writes below affect this loaded serial. Editing the lookup field does not change that target; use Look up component to load another record."
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Serial number to look up"
          },
          "state": {
            "key": "serialNumber",
            "defaultValue": "$view.serialNumber"
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "lookupComponent",
            "args": {
              "view": "$view"
            }
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Registry status",
            "value": "$view.statusId"
          }
        },
        {
          "element": "Address",
          "props": {
            "label": "Owner",
            "address": "$view.owner"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Owner's public info URI",
            "value": "$view.ownerInfo"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Authority of address being viewed",
            "value": "$view.authorityId"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Delegation active",
            "value": "$view.delegationActive"
          }
        },
        {
          "element": "Address",
          "props": {
            "label": "Delegation grantor",
            "address": "$view.delegationGrantor"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Delegation capabilities",
            "value": "$view.delegationCapabilities"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Delegation expiry (Unix seconds)",
            "value": "$view.delegationValidUntil"
          }
        },
        {
          "element": "Nft",
          "props": {
            "contractAddress": "$view.tokenContract",
            "tokenId": "$view.tokenId"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Token URI",
            "value": "$view.tokenURI"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Serial hash",
            "value": "$view.serialHash"
          }
        },
        {
          "element": "Address",
          "props": {
            "label": "Registered by",
            "address": "$view.registrar"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Active means registered with no open missing report. Missing means a report is open. Retired is permanent: metadata updates and missing-report changes are no longer allowed through this registry. It does not burn the NFT or prevent ordinary token transfers."
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Authority and delegation describe the address being viewed. Capability values combine 1 for metadata, 2 for reporting missing, 4 for resolving a report and 8 for retirement. Zero delegation values mean no active delegation in this view. A delegation expires or stops applying when its grantor is no longer the token owner."
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Current missing report URI",
            "value": "$view.missingReportURI"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Token URI is a required nonempty location for token metadata. The contract stores the URI; this viewer displays the NFT contract and token ID without loading that metadata."
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "New token URI"
          },
          "state": {
            "key": "tokenURI",
            "defaultValue": "$view.tokenURI"
          },
          "enabledWhen": {
            "member": "updateComponentMetadata",
            "in": "$view.actions"
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "updateComponentMetadata",
            "args": {
              "view": "$view"
            }
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Publish the missing report and enter its nonempty URI. Confirmation changes an active component to missing and stores this report URI."
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Missing report URI"
          },
          "state": {
            "key": "reportURI",
            "defaultValue": ""
          },
          "enabledWhen": {
            "member": "markComponentMissing",
            "in": "$view.actions"
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "markComponentMissing",
            "args": {
              "view": "$view"
            }
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Publish the explanation for resolving the report and enter its nonempty URI. Confirmation returns a missing component to active, clears the current report URI and records the resolution URI in the transaction event."
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Resolution URI"
          },
          "state": {
            "key": "resolutionURI",
            "defaultValue": ""
          },
          "enabledWhen": {
            "member": "clearComponentMissing",
            "in": "$view.actions"
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "clearComponentMissing",
            "args": {
              "view": "$view"
            }
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Retirement is permanent. Resolve any open missing report first. Retired components cannot have their metadata updated, be reported missing or return to active status through this registry."
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "retireComponent",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "component.active": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "component.found",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "component.missing": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "component.found",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "component.retired": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "component.found",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "register.empty": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "register.form",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "register.ready": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "register.form",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "register.blocked": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "register.form",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "lookupComponent": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Look up component"
      },
      "call": {
        "namespace": "routes",
        "function": "component",
        "args": {
          "serialNumber": "$state.serialNumber"
        }
      },
      "enabledWhen": {
        "member": "lookupComponent",
        "in": "$view.actions"
      }
    },
    "openRegister": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Check registration"
      },
      "call": {
        "namespace": "routes",
        "function": "register",
        "args": {
          "serialNumber": "$state.serialNumber"
        }
      },
      "enabledWhen": {
        "member": "openRegister",
        "in": "$view.actions"
      }
    },
    "registerComponent": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Review registration"
      },
      "call": {
        "namespace": "routes",
        "function": "registerComponent",
        "args": {
          "owner": "$state.owner",
          "serialNumber": "$state.serialNumber",
          "tokenURI": "$state.tokenURI"
        }
      },
      "enabledWhen": {
        "member": "registerComponent",
        "in": "$view.actions"
      }
    },
    "setAccountInfo": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Review account info update"
      },
      "call": {
        "namespace": "routes",
        "function": "setAccountInfo",
        "args": {
          "accountInfo": "$state.accountInfo"
        }
      },
      "enabledWhen": {
        "member": "setAccountInfo",
        "in": "$view.actions"
      }
    },
    "updateComponentMetadata": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Review metadata update"
      },
      "call": {
        "namespace": "routes",
        "function": "updateComponentMetadata",
        "args": {
          "serialNumber": "$view.serialNumber",
          "tokenURI": "$state.tokenURI"
        }
      },
      "enabledWhen": {
        "member": "updateComponentMetadata",
        "in": "$view.actions"
      }
    },
    "markComponentMissing": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Review missing report"
      },
      "call": {
        "namespace": "routes",
        "function": "markComponentMissing",
        "args": {
          "serialNumber": "$view.serialNumber",
          "reportURI": "$state.reportURI"
        }
      },
      "enabledWhen": {
        "member": "markComponentMissing",
        "in": "$view.actions"
      }
    },
    "clearComponentMissing": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Review missing-report resolution"
      },
      "call": {
        "namespace": "routes",
        "function": "clearComponentMissing",
        "args": {
          "serialNumber": "$view.serialNumber",
          "resolutionURI": "$state.resolutionURI"
        }
      },
      "enabledWhen": {
        "member": "clearComponentMissing",
        "in": "$view.actions"
      }
    },
    "retireComponent": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Review permanent retirement"
      },
      "call": {
        "namespace": "routes",
        "function": "retireComponent",
        "args": {
          "serialNumber": "$view.serialNumber"
        }
      },
      "enabledWhen": {
        "member": "retireComponent",
        "in": "$view.actions"
      }
    },
    "register.form": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Text",
          "props": {
            "text": "A registrar sends registration; the initial NFT owner may be a different account. The serial must be unused in this registry. Registration creates an active record and mints its component NFT to that owner."
          }
        },
        {
          "element": "Address",
          "props": {
            "label": "Address being viewed",
            "address": "$view.account"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Registrar role",
            "value": "$view.canRegister"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Component already exists",
            "value": "$view.exists"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Use the exact serial text for this registry. Case and spaces matter; the contract does not trim or normalize it. Enter a nonempty serial to find or register a component."
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Serial number"
          },
          "state": {
            "key": "serialNumber",
            "defaultValue": "$view.serialNumber"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "To check an edited serial, choose Look up component. If it is unused and registration is available, choose Check registration in the lookup result. Registration preparation is disabled when the contracts are paused, the record exists or the viewed account lacks the registrar role."
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Initial NFT owner is required: 0x followed by 40 hexadecimal characters, other than the zero address. The recipient must accept an ERC-721 NFT; contract recipients need the ERC-721 receiver interface."
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Initial NFT owner"
          },
          "state": {
            "key": "owner",
            "defaultValue": ""
          },
          "enabledWhen": {
            "member": "registerComponent",
            "in": "$view.actions"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Token URI is required and nonempty. Publish the token metadata and enter its location; registration stores the URI without fetching or validating its contents."
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Token URI"
          },
          "state": {
            "key": "tokenURI",
            "defaultValue": "$view.tokenURI"
          },
          "enabledWhen": {
            "member": "registerComponent",
            "in": "$view.actions"
          }
        },
        {
          "element": "Address",
          "props": {
            "label": "Component token contract",
            "address": "$view.componentsAddress"
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "registerComponent",
            "args": {
              "view": "$view"
            }
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "lookupComponent",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    }
  }
}
