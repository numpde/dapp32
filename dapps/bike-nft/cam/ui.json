{
  "ui": "1.0.0",
  "nodes": {
    "deploymentHandovers": {
      "element": "Screen", "requires": ["view"], "props": {"title": "Deployment handovers"},
      "children": [
        {"element": "Include", "call": {"namespace": "ui", "function": "navigation", "args": {}}},
        {"element": "Include", "call": {"namespace": "ui", "function": "contractStatus", "args": {"view": "$view"}}},
        {"element": "Text", "props": {"text": "Each authority transfers separately. Connect the nominated wallet to accept. The current owner or administrator keeps authority until acceptance succeeds. The two admin waits use chain time; refresh after the acceptance time has passed."}},
        {"element": "Button", "props": {"label": "Refresh handovers"}, "call": {"namespace": "routes", "function": "deploymentHandovers", "args": {}}},
        {"element": "Screen", "props": {"title": "CAM ownership"}, "children": [
          {"element": "Status", "props": {"label": "CAM host", "value": "$view.cam.target"}},
          {"element": "Status", "props": {"label": "Current owner", "value": "$view.cam.current"}},
          {"element": "Status", "props": {"label": "Nominated owner (zero means none)", "value": "$view.cam.pending"}},
          {"element": "Status", "props": {"label": "Acceptance", "value": "$view.cam.status"}},
          {"element": "Text", "props": {"text": "The owner can change the CAM manifest and contract bindings. There is no acceptance delay."}},
          {"element": "Button", "props": {"label": "Accept CAM ownership"}, "enabledWhen": {"member": "acceptCamOwnership", "in": "$view.actions"}, "call": {"namespace": "routes", "function": "acceptCamOwnership", "args": {}}}
        ]},
        {"element": "Screen", "props": {"title": "Components administrator"}, "children": [
          {"element": "Status", "props": {"label": "NFT collection", "value": "$view.components.target"}},
          {"element": "Status", "props": {"label": "Current administrator", "value": "$view.components.current"}},
          {"element": "Status", "props": {"label": "Nominated administrator (zero means none)", "value": "$view.components.pending"}},
          {"element": "Status", "props": {"label": "Acceptance time", "value": "$view.components.readyAt", "format": "timestampSeconds", "zeroText": "Not scheduled"}},
          {"element": "Status", "props": {"label": "Acceptance", "value": "$view.components.status"}},
          {"element": "Text", "props": {"text": "The administrator manages the collection's operational roles and future administrator transfers."}},
          {"element": "Button", "props": {"label": "Accept Components administration"}, "enabledWhen": {"member": "acceptComponentsAdmin", "in": "$view.actions"}, "call": {"namespace": "routes", "function": "acceptComponentsAdmin", "args": {}}}
        ]},
        {"element": "Screen", "props": {"title": "Manager administrator"}, "children": [
          {"element": "Status", "props": {"label": "Registry manager", "value": "$view.manager.target"}},
          {"element": "Status", "props": {"label": "Current administrator", "value": "$view.manager.current"}},
          {"element": "Status", "props": {"label": "Nominated administrator (zero means none)", "value": "$view.manager.pending"}},
          {"element": "Status", "props": {"label": "Acceptance time", "value": "$view.manager.readyAt", "format": "timestampSeconds", "zeroText": "Not scheduled"}},
          {"element": "Status", "props": {"label": "Acceptance", "value": "$view.manager.status"}},
          {"element": "Text", "props": {"text": "The administrator manages registrar and operational roles and future administrator transfers."}},
          {"element": "Button", "props": {"label": "Accept Manager administration"}, "enabledWhen": {"member": "acceptManagerAdmin", "in": "$view.actions"}, "call": {"namespace": "routes", "function": "acceptManagerAdmin", "args": {}}}
        ]}
      ]
    },
    "app": {
      "element": "Screen",
      "requires": [
        "view"
      ],
      "props": {
        "title": "Bicycle component registry"
      },
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "navigation",
            "args": {}
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "contractStatus",
            "args": {
              "view": "$view"
            }
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "$view.viewId",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "contractStatus": {
      "element": "Screen",
      "requires": [
        "view"
      ],
      "props": {
        "title": "Contract status"
      },
      "children": [
        {
          "element": "Status",
          "props": {
            "label": "Registry paused",
            "value": "$view.paused"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Component token paused",
            "value": "$view.componentTokenPaused"
          }
        }
      ]
    },
    "entry": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Screen",
          "props": {
            "title": "Find a component"
          },
          "children": [
            {
              "element": "Text",
              "props": {
                "text": "Use the exact serial text for this registry. Case and spaces matter; the contract does not trim or normalize it. Enter a nonempty serial, then choose Look up component to find it or Check registration to check whether it can be registered."
              }
            },
            {
              "element": "TextField",
              "props": {
                "label": "Serial number to look up"
              },
              "state": {
                "key": "serialNumber",
                "defaultValue": "$view.serialNumber"
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "lookupComponent",
                "args": {
                  "view": "$view"
                }
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "openRegister",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        },
        {
          "element": "Screen",
          "props": {
            "title": "Account profile"
          },
          "children": [
            {
              "element": "Address",
              "props": {
                "label": "Address being viewed",
                "address": "$view.account"
              }
            },
            {
              "element": "Status",
              "props": {
                "label": "Registrar role",
                "value": "$view.canRegister"
              }
            },
            {
              "element": "Text",
              "props": {
                "text": "Account info URI is an optional public profile or contact-document location for the account sending the update. Enter an empty value to clear it."
              }
            },
            {
              "element": "TextField",
              "props": {
                "label": "Account info URI"
              },
              "state": {
                "key": "accountInfo",
                "defaultValue": "$view.accountInfo"
              },
              "enabledWhen": {
                "member": "setAccountInfo",
                "in": "$view.actions"
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "setAccountInfo",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        }
      ]
    },
    "component.empty": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Screen",
          "props": {
            "title": "Find a component"
          },
          "children": [
            {
              "element": "Text",
              "props": {
                "text": "Use the exact serial text for this registry. Case and spaces matter; the contract does not trim or normalize it. Enter a nonempty serial to find or register a component."
              }
            },
            {
              "element": "TextField",
              "props": {
                "label": "Serial number to look up"
              },
              "state": {
                "key": "serialNumber",
                "defaultValue": "$view.serialNumber"
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "lookupComponent",
                "args": {
                  "view": "$view"
                }
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "openRegister",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        }
      ]
    },
    "component.notFound": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Screen",
          "props": {
            "title": "Find a component"
          },
          "children": [
            {
              "element": "Text",
              "props": {
                "text": "No component is registered for this exact serial in this registry. Check the serial, contract and network before registering."
              }
            },
            {
              "element": "TextField",
              "props": {
                "label": "Serial number to look up"
              },
              "state": {
                "key": "serialNumber",
                "defaultValue": "$view.serialNumber"
              }
            },
            {
              "element": "Status",
              "props": {
                "label": "Registered",
                "value": false
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "lookupComponent",
                "args": {
                  "view": "$view"
                }
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "openRegister",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        }
      ]
    },
    "component.found": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Screen",
          "props": {
            "title": "Component details"
          },
          "children": [
            {
              "element": "Status",
              "props": {
                "label": "Loaded component serial",
                "value": "$view.serialNumber"
              }
            },
            {
              "element": "Status",
              "props": {
                "label": "Registry status",
                "value": "$view.statusId"
              }
            },
            {
              "element": "Address",
              "props": {
                "label": "Owner",
                "address": "$view.owner"
              }
            },
            {
              "element": "Status",
              "props": {
                "label": "Owner's public info URI",
                "value": "$view.ownerInfo"
              }
            },
            {
              "element": "Screen",
              "props": {
                "title": "Access for viewed account"
              },
              "children": [
                {
                  "element": "Status",
                  "props": {
                    "label": "Authority of address being viewed",
                    "value": "$view.authorityId"
                  }
                },
                {
                  "element": "Status",
                  "props": {
                    "label": "Delegation active",
                    "value": "$view.delegationActive"
                  }
                },
                {
                  "element": "Address",
                  "props": {
                    "label": "Delegation grantor",
                    "address": "$view.delegationGrantor"
                  }
                },
                {
                  "element": "Status",
                  "props": {
                    "label": "Delegation capabilities",
                    "value": "$view.delegationCapabilities"
                  }
                },
                {
                  "element": "Status",
                  "props": {
                    "label": "Delegation expiry (Unix seconds)",
                    "value": "$view.delegationValidUntil"
                  }
                }
              ]
            },
            {
              "element": "Screen",
              "props": {
                "title": "Registration details"
              },
              "children": [
                {
                  "element": "Address",
                  "props": {
                    "label": "Registered by",
                    "address": "$view.registrar"
                  }
                },
                {
                  "element": "Status",
                  "props": {
                    "label": "Serial hash",
                    "value": "$view.serialHash"
                  }
                }
              ]
            }
          ]
        },
        {
          "element": "Screen",
          "props": {
            "title": "NFT details"
          },
          "children": [
            {
              "element": "Nft",
              "props": {
                "contractAddress": "$view.tokenContract",
                "tokenId": "$view.tokenId",
                "metadataURI": "$view.tokenURI"
              }
            },
            {
              "element": "Text",
              "props": {
                "text": "The NFT name, description and image come from a JSON document. Choose where to keep that document below, then review the update."
              }
            },
            {
              "element": "NftMetadataField",
              "props": {
                "label": "Edit NFT details"
              },
              "state": {
                "key": "tokenURI",
                "defaultValue": "$view.tokenURI"
              },
              "enabledWhen": {
                "member": "updateComponentMetadata",
                "in": "$view.actions"
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "updateComponentMetadata",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        },
        {
          "element": "Screen",
          "props": {
            "title": "Missing reports"
          },
          "children": [
            {
              "element": "Text",
              "props": {
                "text": "Active means no missing report is open. Missing means a report is open. Out of service is a separate, reversible owner decision; changing it does not open or resolve a missing report."
              }
            },
            {
              "element": "Status",
              "props": {
                "label": "Current missing report URI",
                "value": "$view.missingReportURI"
              }
            },
            {
              "element": "Text",
              "props": {
                "text": "Publish the missing report and enter its nonempty URI. Confirmation changes an active component to missing and stores this report URI."
              }
            },
            {
              "element": "TextField",
              "props": {
                "label": "Missing report URI"
              },
              "state": {
                "key": "reportURI",
                "defaultValue": ""
              },
              "enabledWhen": {
                "member": "markComponentMissing",
                "in": "$view.actions"
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "markComponentMissing",
                "args": {
                  "view": "$view"
                }
              }
            },
            {
              "element": "Text",
              "props": {
                "text": "Publish the explanation for resolving the report and enter its nonempty URI. Confirmation clears the report and records the resolution URI in the transaction event. It does not change whether the component is out of service."
              }
            },
            {
              "element": "TextField",
              "props": {
                "label": "Resolution URI"
              },
              "state": {
                "key": "resolutionURI",
                "defaultValue": ""
              },
              "enabledWhen": {
                "member": "clearComponentMissing",
                "in": "$view.actions"
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "clearComponentMissing",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        },
        {
          "element": "Screen",
          "props": {
            "title": "Service state"
          },
          "children": [
            {
              "element": "Status",
              "props": {
                "label": "Out of service",
                "value": "$view.inactive"
              }
            },
            {
              "element": "Text",
              "props": {
                "text": "Only the current owner can take a component out of service or reactivate it. Metadata corrections and ordinary NFT transfers remain available in either state."
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "decommissionComponent",
                "args": {
                  "view": "$view"
                }
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "reactivateComponent",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        },
        {
          "element": "Screen",
          "props": {
            "title": "Workshop access"
          },
          "children": [
            {
              "element": "Text",
              "props": {
                "text": "Workshop grants permit selected registry updates. They do not approve NFT transfers. Grants expire and are permanently invalidated by a change of owner, even if the NFT later returns."
              }
            },
            {
              "element": "Text",
              "props": {
                "text": "Enter a workshop address and choose an access duration to inspect its grant and preview an expiry. This registry does not enumerate every workshop grant."
              }
            },
            {
              "element": "TextField",
              "props": {
                "label": "Workshop address"
              },
              "state": {
                "key": "delegate",
                "defaultValue": ""
              },
              "enabledWhen": {
                "member": "delegation",
                "in": "$view.actions"
              }
            },
            {
              "element": "DurationField",
              "props": {
                "label": "Workshop access duration (required)",
                "min": "1",
                "max": "$view.maxDelegationDuration"
              },
              "state": {
                "key": "duration",
                "defaultValue": ""
              },
              "enabledWhen": {
                "member": "delegation",
                "in": "$view.actions"
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "openDelegation",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        },
        {
          "element": "Screen",
          "props": {
            "title": "Transfer ownership"
          },
          "children": [
            {
              "element": "Text",
              "props": {
                "text": "Handover transfers the loaded component NFT directly. It does not settle payment or prove physical delivery or recipient consent. Check the recipient carefully; contract recipients must accept ERC-721 NFTs. Missing reports and out-of-service status remain attached to the record."
              }
            },
            {
              "element": "TextField",
              "props": {
                "label": "Recipient NFT owner"
              },
              "state": {
                "key": "to",
                "defaultValue": ""
              },
              "enabledWhen": {
                "member": "transferComponent",
                "in": "$view.actions"
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "transferComponent",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        }
      ]
    },
    "component.active": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "component.found",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "component.missing": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "component.found",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "component.retired": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Text",
          "props": {
            "text": "Legacy retired record: retirement was permanent in that deployment. This view is read-only and does not convert retirement into reversible inactivity."
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "component.found",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "register.empty": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "register.form",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "register.ready": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "register.form",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "register.blocked": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "register.form",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "lookupComponent": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Look up component"
      },
      "call": {
        "namespace": "routes",
        "function": "component",
        "args": {
          "serialNumber": "$state.serialNumber"
        }
      },
      "enabledWhen": {
        "member": "lookupComponent",
        "in": "$view.actions"
      }
    },
    "openRegister": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Check registration"
      },
      "call": {
        "namespace": "routes",
        "function": "register",
        "args": {
          "serialNumber": "$state.serialNumber"
        }
      },
      "enabledWhen": {
        "member": "openRegister",
        "in": "$view.actions"
      }
    },
    "registerComponent": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Register component"
      },
      "call": {
        "namespace": "routes",
        "function": "registerComponent",
        "args": {
          "owner": "$state.owner",
          "serialNumber": "$state.serialNumber",
          "tokenURI": "$state.tokenURI"
        }
      },
      "enabledWhen": {
        "member": "registerComponent",
        "in": "$view.actions"
      }
    },
    "setAccountInfo": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Update account info"
      },
      "call": {
        "namespace": "routes",
        "function": "setAccountInfo",
        "args": {
          "accountInfo": "$state.accountInfo"
        }
      },
      "enabledWhen": {
        "member": "setAccountInfo",
        "in": "$view.actions"
      }
    },
    "updateComponentMetadata": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Update NFT details"
      },
      "call": {
        "namespace": "routes",
        "function": "updateComponentMetadata",
        "args": {
          "serialNumber": "$view.serialNumber",
          "tokenURI": "$state.tokenURI"
        }
      },
      "enabledWhen": {
        "member": "updateComponentMetadata",
        "in": "$view.actions"
      }
    },
    "markComponentMissing": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Report component missing"
      },
      "call": {
        "namespace": "routes",
        "function": "markComponentMissing",
        "args": {
          "serialNumber": "$view.serialNumber",
          "reportURI": "$state.reportURI"
        }
      },
      "enabledWhen": {
        "member": "markComponentMissing",
        "in": "$view.actions"
      }
    },
    "clearComponentMissing": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Resolve missing report"
      },
      "call": {
        "namespace": "routes",
        "function": "clearComponentMissing",
        "args": {
          "serialNumber": "$view.serialNumber",
          "resolutionURI": "$state.resolutionURI"
        }
      },
      "enabledWhen": {
        "member": "clearComponentMissing",
        "in": "$view.actions"
      }
    },
    "register.form": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Screen",
          "props": {
            "title": "Check a serial"
          },
          "children": [
            {
              "element": "Text",
              "props": {
                "text": "Use the exact serial text for this registry. Case and spaces matter; the contract does not trim or normalize it. Enter a nonempty serial to find or register a component."
              }
            },
            {
              "element": "TextField",
              "props": {
                "label": "Serial number"
              },
              "state": {
                "key": "serialNumber",
                "defaultValue": "$view.serialNumber"
              }
            },
            {
              "element": "Text",
              "props": {
                "text": "To check an edited serial, choose Look up component. If it is unused and registration is available, choose Check registration in the lookup result. Registration preparation is disabled when the contracts are paused, the record exists or the viewed account lacks the registrar role."
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "lookupComponent",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        },
        {
          "element": "Screen",
          "props": {
            "title": "Register component"
          },
          "children": [
            {
              "element": "Text",
              "props": {
                "text": "A registrar sends registration; the initial NFT owner may be a different account. The serial must be unused in this registry. Registration creates an active record and mints its component NFT to that owner."
              }
            },
            {
              "element": "Status",
              "props": {
                "label": "Serial checked for registration",
                "value": "$view.serialNumber"
              }
            },
            {
              "element": "Address",
              "props": {
                "label": "Address being viewed",
                "address": "$view.account"
              }
            },
            {
              "element": "Status",
              "props": {
                "label": "Registrar role",
                "value": "$view.canRegister"
              }
            },
            {
              "element": "Status",
              "props": {
                "label": "Component already exists",
                "value": "$view.exists"
              }
            },
            {
              "element": "Text",
              "props": {
                "text": "Initial NFT owner is required: 0x followed by 40 hexadecimal characters, other than the zero address. The recipient must accept an ERC-721 NFT; contract recipients need the ERC-721 receiver interface."
              }
            },
            {
              "element": "TextField",
              "props": {
                "label": "Initial NFT owner"
              },
              "state": {
                "key": "owner",
                "defaultValue": ""
              },
              "enabledWhen": {
                "member": "registerComponent",
                "in": "$view.actions"
              }
            },
            {
              "element": "Text",
              "props": {
                "text": "The NFT name, description and image come from a JSON document. Choose where to keep that document below. Registration mints the NFT using the selected document URI."
              }
            },
            {
              "element": "NftMetadataField",
              "props": {
                "label": "NFT details"
              },
              "state": {
                "key": "tokenURI",
                "defaultValue": "$view.tokenURI"
              },
              "enabledWhen": {
                "member": "registerComponent",
                "in": "$view.actions"
              }
            },
            {
              "element": "Address",
              "props": {
                "label": "Component token contract",
                "address": "$view.componentsAddress"
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "registerComponent",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        }
      ]
    },
    "decommissionComponent": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Take out of service"
      },
      "call": {
        "namespace": "routes",
        "function": "decommissionComponent",
        "args": {
          "serialNumber": "$view.serialNumber"
        }
      },
      "enabledWhen": {
        "member": "decommissionComponent",
        "in": "$view.actions"
      }
    },
    "reactivateComponent": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Reactivate"
      },
      "call": {
        "namespace": "routes",
        "function": "reactivateComponent",
        "args": {
          "serialNumber": "$view.serialNumber"
        }
      },
      "enabledWhen": {
        "member": "reactivateComponent",
        "in": "$view.actions"
      }
    },
    "component.inactive": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "component.found",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "transferComponent": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Transfer NFT"
      },
      "call": {
        "namespace": "routes",
        "function": "transferComponent",
        "args": {
          "serialNumber": "$view.serialNumber",
          "to": "$state.to"
        }
      },
      "enabledWhen": {
        "member": "transferComponent",
        "in": "$view.actions"
      }
    },
    "openDelegation": {
      "requires": [
        "view"
      ],
      "element": "Button",
      "props": {
        "label": "Inspect workshop and preview expiry"
      },
      "call": {
        "namespace": "routes",
        "function": "delegation",
        "args": {
          "serialNumber": "$view.serialNumber",
          "delegate": "$state.delegate",
          "duration": "$state.duration"
        }
      },
      "enabledWhen": {
        "member": "delegation",
        "in": "$view.actions"
      }
    },
    "delegation": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Button",
          "props": {
            "label": "Back to loaded component"
          },
          "call": {
            "namespace": "routes",
            "function": "component",
            "args": {
              "serialNumber": "$view.serialNumber"
            }
          },
          "enabledWhen": {
            "member": "lookupComponent",
            "in": "$view.actions"
          }
        },
        {
          "element": "Screen",
          "props": {
            "title": "Inspected workshop grant"
          },
          "children": [
            {
              "element": "Status",
              "props": {
                "label": "Loaded component serial",
                "value": "$view.serialNumber"
              }
            },
            {
              "element": "Address",
              "props": {
                "label": "Owner",
                "address": "$view.owner"
              }
            },
            {
              "element": "Address",
              "props": {
                "label": "Workshop",
                "address": "$view.delegate"
              }
            },
            {
              "element": "Address",
              "props": {
                "label": "Delegation grantor",
                "address": "$view.delegationGrantor"
              }
            },
            {
              "element": "Status",
              "props": {
                "label": "Delegation capabilities",
                "value": "$view.delegationCapabilities"
              }
            },
            {
              "element": "Status",
              "props": {
                "label": "Delegation expiry (Unix seconds)",
                "value": "$view.delegationValidUntil"
              }
            },
            {
              "element": "Status",
              "props": {
                "label": "Delegation active",
                "value": "$view.delegationActive"
              }
            },
            {
              "element": "Text",
              "props": {
                "text": "Workshop grants allow registry updates only. They do not approve NFT transfers. A change of owner permanently invalidates the grant."
              }
            }
          ]
        },
        {
          "element": "Screen",
          "props": {
            "title": "Inspect a workshop"
          },
          "children": [
            {
              "element": "Text",
              "props": {
                "text": "Inspect a workshop grant by address. Editing the address or duration does not change the inspected grant or its previewed expiry until you preview again."
              }
            },
            {
              "element": "TextField",
              "props": {
                "label": "Workshop address"
              },
              "state": {
                "key": "delegate",
                "defaultValue": "$view.delegate"
              },
              "enabledWhen": {
                "member": "delegation",
                "in": "$view.actions"
              }
            },
            {
              "element": "DurationField",
              "props": {
                "label": "Workshop access duration",
                "min": "1",
                "max": "$view.maxDelegationDuration"
              },
              "state": {
                "key": "duration",
                "defaultValue": "$view.duration"
              },
              "enabledWhen": {
                "member": "delegation",
                "in": "$view.actions"
              }
            },
            {
              "element": "Include",
              "call": {
                "namespace": "ui",
                "function": "openDelegation",
                "args": {
                  "view": "$view"
                }
              }
            }
          ]
        },
        {
          "element": "Screen",
          "props": {
            "title": "Change workshop permissions"
          },
          "children": [
            {
              "element": "Status",
              "props": {
                "label": "Previewed expiry (Unix seconds)",
                "value": "$view.validUntil"
              }
            },
            {
              "element": "Text",
              "props": {
                "text": "Each preset replaces the workshop's existing permissions and expiry with the selected permissions and previewed expiry shown above. Preview again after changing the workshop or duration. Revocation targets the inspected workshop."
              }
            },
            {
              "element": "Button",
              "props": {
                "label": "Set metadata update permission"
              },
              "call": {
                "namespace": "routes",
                "function": "setComponentDelegate",
                "args": {
                  "serialNumber": "$view.serialNumber",
                  "delegate": "$view.delegate",
                  "capabilities": "1",
                  "validUntil": "$view.validUntil"
                }
              },
              "enabledWhen": {
                "member": "setComponentDelegate",
                "in": "$view.actions"
              }
            },
            {
              "element": "Button",
              "props": {
                "label": "Set permission to report missing"
              },
              "call": {
                "namespace": "routes",
                "function": "setComponentDelegate",
                "args": {
                  "serialNumber": "$view.serialNumber",
                  "delegate": "$view.delegate",
                  "capabilities": "2",
                  "validUntil": "$view.validUntil"
                }
              },
              "enabledWhen": {
                "member": "setComponentDelegate",
                "in": "$view.actions"
              }
            },
            {
              "element": "Button",
              "props": {
                "label": "Set permission to resolve missing reports"
              },
              "call": {
                "namespace": "routes",
                "function": "setComponentDelegate",
                "args": {
                  "serialNumber": "$view.serialNumber",
                  "delegate": "$view.delegate",
                  "capabilities": "4",
                  "validUntil": "$view.validUntil"
                }
              },
              "enabledWhen": {
                "member": "setComponentDelegate",
                "in": "$view.actions"
              }
            },
            {
              "element": "Button",
              "props": {
                "label": "Set all workshop permissions"
              },
              "call": {
                "namespace": "routes",
                "function": "setComponentDelegate",
                "args": {
                  "serialNumber": "$view.serialNumber",
                  "delegate": "$view.delegate",
                  "capabilities": "7",
                  "validUntil": "$view.validUntil"
                }
              },
              "enabledWhen": {
                "member": "setComponentDelegate",
                "in": "$view.actions"
              }
            },
            {
              "element": "Button",
              "props": {
                "label": "Revoke workshop access"
              },
              "call": {
                "namespace": "routes",
                "function": "revokeComponentDelegate",
                "args": {
                  "serialNumber": "$view.serialNumber",
                  "delegate": "$view.delegate"
                }
              },
              "enabledWhen": {
                "member": "revokeComponentDelegate",
                "in": "$view.actions"
              }
            }
          ]
        }
      ]
    },
    "navigation": {
      "element": "Screen",
      "requires": [],
      "props": {
        "title": "App navigation"
      },
      "children": [
        {
          "element": "Button",
          "props": {
            "label": "Find a component"
          },
          "call": {
            "namespace": "routes",
            "function": "entry",
            "args": {}
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Register a component"
          },
          "call": {
            "namespace": "routes",
            "function": "register",
            "args": {
              "serialNumber": ""
            }
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Deployment handovers"
          },
          "call": {
            "namespace": "routes",
            "function": "deploymentHandovers",
            "args": {}
          }
        }
      ]
    }
  }
}
