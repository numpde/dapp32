      },
      "call": {
        "namespace": "contracts.BicycleComponents",
        "target": "$outputs.0",
        "function": "safeTransferFrom(address,address,uint256)",
        "args": {
          "from": "$account.address",
          "to": "$inputs.to",
          "tokenId": "$outputs.1"
