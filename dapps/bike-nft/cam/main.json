          "account": "$account.address",
          "duration": "$inputs.duration"
        }
      },
      "then": {
        "namespace": "ui",
        "function": "app",
        "args": {
          "view": "$outputs.0"
        }
      }
    },
    "setComponentDelegate": {
      "kind": "write",
      "inputs": [
        "serialNumber",
        "delegate",
        "capabilities",
        "validUntil"
      ],
      "call": {
        "namespace": "contracts.BicycleComponentManager",
        "function": "setComponentDelegate",
        "args": {
          "serialNumber": "$inputs.serialNumber",
          "delegate": "$inputs.delegate",
          "capabilities": "$inputs.capabilities",
          "validUntil": "$inputs.validUntil"
        }
      },
      "then": {
        "namespace": "routes",
        "function": "component",
        "args": {
          "serialNumber": "$inputs.serialNumber"
