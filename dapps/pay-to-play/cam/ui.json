{
  "ui": "1.0.0",
  "nodes": {
    "positionFields": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Text",
          "props": {
            "text": "Deposits are held by the Pay-to-Play contract. Each account has a separate balance in each channel. A channel sets the payment recipient and withdrawal waiting time. Review buttons prepare and simulate a transaction without sending it. Send with wallet submits it; wait for confirmation before relying on the result."
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Balance owner",
            "value": "$view.customer"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Channel ID",
            "value": "$view.channelId"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Payment recipient (unused in channel 0)",
            "value": "$view.payee"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "This channel’s withdrawal wait",
            "value": "$view.claimPeriod",
            "format": "durationSeconds"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Channel admin",
            "value": "$view.admin"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Channels created (including channel 0)",
            "value": "$view.channelCount"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Channel 0 holds deposits that vouchers cannot spend. Move funds to another channel to make them available for voucher payments. The admin can change the recipient of other channels, including for vouchers already signed."
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Current balance (wei)",
            "value": "$view.balance"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Balance minus withdrawal request (wei)",
            "value": "$view.effectiveBalance"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Total paid by vouchers (wei)",
            "value": "$view.voucherPaid"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Withdrawal requested (wei)",
            "value": "$view.requestedAmount"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Withdrawal ready at",
            "value": "$view.readyAt",
            "format": "timestampSeconds",
            "zeroText": "No active withdrawal request"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "A withdrawal request does not set money aside. Vouchers can still spend the deposited balance while you wait. Balance minus withdrawal request subtracts only the request, never goes below zero, and does not subtract unpaid vouchers. A requested amount of 0 means no request."
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Change account or channel"
          },
          "call": {
            "namespace": "routes",
            "function": "choosePosition",
            "args": {
              "customer": "$view.customer",
              "channelId": "$view.channelId"
            }
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Deposit into this channel"
          }
        },
        {
          "element": "AmountField",
          "props": {
            "label": "Amount to deposit",
            "unit": {
              "assetId": "native",
              "baseLabel": "Wei (smallest unit)",
              "displayLabel": "Native coins",
              "decimals": 18
            }
          },
          "state": {
            "key": "fundAmount",
            "defaultValue": ""
          },
          "enabledWhen": {
            "member": "fund",
            "in": "$view.actions"
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Review deposit"
          },
          "call": {
            "namespace": "routes",
            "function": "fund",
            "args": {
              "channelId": "$view.channelId",
              "amount": "$state.fundAmount"
            }
          },
          "enabledWhen": {
            "member": "fund",
            "in": "$view.actions"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "The deposit credits the sender’s balance in this channel, not the recipient. Use either amount box; fees are separate. It neither signs a voucher nor restarts an active withdrawal wait."
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Get a deposit back"
          }
        },
        {
          "element": "AmountField",
          "props": {
            "label": "Amount to request back",
            "unit": {
              "assetId": "native",
              "baseLabel": "Wei (smallest unit)",
              "displayLabel": "Native coins",
              "decimals": 18
            }
          },
          "state": {
            "key": "withdrawAmount",
            "defaultValue": ""
          },
          "enabledWhen": {
            "member": "setWithdrawal",
            "in": "$view.actions"
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Review withdrawal request"
          },
          "call": {
            "namespace": "routes",
            "function": "requestWithdrawal",
            "args": {
              "channelId": "$view.channelId",
              "amount": "$state.withdrawAmount"
            }
          },
          "enabledWhen": {
            "member": "requestWithdrawal",
            "in": "$view.actions"
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Review replacement request"
          },
          "call": {
            "namespace": "routes",
            "function": "setWithdrawal",
            "args": {
              "channelId": "$view.channelId",
              "amount": "$state.withdrawAmount"
            }
          },
          "enabledWhen": {
            "member": "setWithdrawal",
            "in": "$view.actions"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Only the owner can start or replace a request. The amount must be positive and no greater than the current balance. This channel’s full wait starts when the request transaction is included in a block. Replacing a request restarts the full wait. Requests cannot be cancelled."
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Review withdrawal to balance owner"
          },
          "call": {
            "namespace": "routes",
            "function": "withdraw",
            "args": {
              "customer": "$view.customer",
              "channelId": "$view.channelId"
            }
          },
          "enabledWhen": {
            "member": "withdraw",
            "in": "$view.actions"
          }
        },
        {
          "element": "NonNegativeIntegerField",
          "props": {
            "label": "Move to channel ID"
          },
          "state": {
            "key": "targetId",
            "defaultValue": ""
          },
          "enabledWhen": {
            "member": "move",
            "in": "$view.actions"
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Review move to another channel"
          },
          "call": {
            "namespace": "routes",
            "function": "move",
            "args": {
              "channelId": "$view.channelId",
              "targetId": "$state.targetId"
            }
          },
          "enabledWhen": {
            "member": "move",
            "in": "$view.actions"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "When the chain reaches the ready time, anyone can submit a withdrawal back to the owner. Only the owner can move funds to another channel for that same owner. Both transfer the smaller of the requested amount and current remaining balance, then clear the request—even if zero. Later deposits require a new request and full wait. Refresh re-reads all displayed values and available actions from the latest block."
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Pay using a signed voucher"
          }
        },
        {
          "element": "AmountField",
          "props": {
            "label": "Authorized total so far",
            "unit": {
              "assetId": "native",
              "baseLabel": "Wei (smallest unit)",
              "displayLabel": "Native coins",
              "decimals": 18
            }
          },
          "state": {
            "key": "cumulativeTotal",
            "defaultValue": ""
          },
          "enabledWhen": {
            "member": "collect",
            "in": "$view.actions"
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "View signing details"
          },
          "call": {
            "namespace": "routes",
            "function": "voucherDigest",
            "args": {
              "customer": "$view.customer",
              "channelId": "$view.channelId",
              "cumulativeTotal": "$state.cumulativeTotal"
            }
          },
          "enabledWhen": {
            "member": "collect",
            "in": "$view.actions"
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Balance owner’s voucher signature"
          },
          "state": {
            "key": "signature",
            "defaultValue": ""
          },
          "enabledWhen": {
            "member": "collect",
            "in": "$view.actions"
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Review voucher payment"
          },
          "call": {
            "namespace": "routes",
            "function": "collect",
            "args": {
              "customer": "$view.customer",
              "channelId": "$view.channelId",
              "cumulativeTotal": "$state.cumulativeTotal",
              "signature": "$state.signature"
            }
          },
          "enabledWhen": {
            "member": "collect",
            "in": "$view.actions"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Anyone can submit the owner’s valid voucher for this channel. Get its signature from an external EIP-712 signer and enter the signed total with it. Signing details show a comparison hash; this app does not create signatures."
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "For this owner and channel, the total includes earlier voucher payments. With a signed total of 100 wei and 30 wei already paid, up to 70 wei remains authorized, limited by the current remaining balance. After a partial payment and later deposit, the same voucher can pay again. Authorization does not expire. Payments go to the current recipient."
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "createChannelFields",
            "args": {
              "view": "$view"
            }
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "New recipient for this channel"
          },
          "state": {
            "key": "replacementPayee",
            "defaultValue": ""
          },
          "enabledWhen": {
            "member": "setPayee",
            "in": "$view.actions"
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Review recipient change"
          },
          "call": {
            "namespace": "routes",
            "function": "setPayee",
            "args": {
              "customer": "$view.customer",
              "channelId": "$view.channelId",
              "payee": "$state.replacementPayee"
            }
          },
          "enabledWhen": {
            "member": "setPayee",
            "in": "$view.actions"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Only the admin can create channels or change recipients. A recipient change redirects unpaid voucher payments from every customer in this channel, including already-signed vouchers. Customer balances and withdrawal waits stay the same."
          }
        }
      ]
    },
    "voucher": {
      "requires": [
        "view"
      ],
      "element": "Screen",
      "props": {
        "title": "Voucher signing details"
      },
      "children": [
        {
          "element": "Status",
          "props": {
            "label": "Balance owner",
            "value": "$view.customer"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Channel ID",
            "value": "$view.channelId"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Authorized total so far (wei)",
            "value": "$view.cumulativeTotal"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Chain ID",
            "value": "$view.chainId"
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Signing hash (EIP-712 digest)",
            "value": "$view.digest"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "This hash is for comparison, not a signature. Sign the full EIP-712 Voucher in another tool, not a personal message. Domain: name PayToPlay, version 1, this chain ID, and the deployed PayToPlay contract address as verifyingContract. The CAM host address is not the payment contract. The guide contains the full schema and local signing command."
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Back restores your earlier inputs when this session has a previous view. Viewing the balance below starts with fresh inputs."
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "View balance with fresh inputs"
          },
          "call": {
            "namespace": "routes",
            "function": "position",
            "args": {
              "customer": "$view.customer",
              "channelId": "$view.channelId"
            }
          }
        }
      ]
    },
    "position": {
      "requires": [
        "view"
      ],
      "element": "Screen",
      "props": {
        "title": "Pay-to-Play"
      },
      "children": [
        {
          "element": "Text",
          "props": {
            "text": "Account balance"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "This owner and channel stay open when you connect or change wallet accounts. Deposit, request and move require this owner’s account. Any account can submit a valid voucher (except in channel 0) or a ready withdrawal back to the owner. Connecting or changing wallet accounts clears form entries."
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "positionFields",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "channelLookup": {
      "requires": [
        "view"
      ],
      "element": "Screen",
      "props": {
        "title": "Pay-to-Play"
      },
      "children": [
        {
          "element": "Text",
          "props": {
            "text": "Find a channel ID"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Find the new channel’s exact ID in the ChannelCreated event in your transaction receipt. This viewer shows the transaction hash, but does not decode that event. The channel count alone cannot identify your new channel."
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "balanceChooserFields",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "createChannelFields": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Text",
          "props": {
            "text": "Manage channels (admin only)"
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Payment recipient for new channel"
          },
          "state": {
            "key": "newPayee",
            "defaultValue": ""
          },
          "enabledWhen": {
            "member": "createChannel",
            "in": "$view.actions"
          }
        },
        {
          "element": "DurationField",
          "props": {
            "label": "Withdrawal wait for new channel"
          },
          "state": {
            "key": "newClaimPeriod",
            "defaultValue": ""
          },
          "enabledWhen": {
            "member": "createChannel",
            "in": "$view.actions"
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Review new channel"
          },
          "call": {
            "namespace": "routes",
            "function": "createChannel",
            "args": {
              "payee": "$state.newPayee",
              "claimPeriod": "$state.newClaimPeriod"
            }
          },
          "enabledWhen": {
            "member": "createChannel",
            "in": "$view.actions"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "A channel’s withdrawal wait cannot change. After creation, find its ID in the ChannelCreated event in your transaction receipt. This viewer shows the transaction hash, but does not decode that event. The lookup lets you enter the ID once you have it."
          }
        }
      ]
    },
    "balanceChooserFields": {
      "requires": [
        "view"
      ],
      "element": "Fragment",
      "children": [
        {
          "element": "Text",
          "props": {
            "text": "Choose an account and channel"
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Enter the balance owner and an existing channel ID, then open that balance. This only reads it; no transaction is sent. The opened owner and channel stay fixed when wallet accounts change."
          }
        },
        {
          "element": "Text",
          "props": {
            "text": "Channel 0 holds deposits that vouchers cannot spend. Choose another existing channel for voucher payments."
          }
        },
        {
          "element": "TextField",
          "props": {
            "label": "Balance owner address"
          },
          "state": {
            "key": "lookupCustomer",
            "defaultValue": "$view.customer"
          }
        },
        {
          "element": "NonNegativeIntegerField",
          "props": {
            "label": "Channel ID"
          },
          "state": {
            "key": "lookupChannelId",
            "defaultValue": "$view.channelId"
          }
        },
        {
          "element": "Button",
          "props": {
            "label": "Open balance"
          },
          "call": {
            "namespace": "routes",
            "function": "position",
            "args": {
              "customer": "$state.lookupCustomer",
              "channelId": "$state.lookupChannelId"
            }
          }
        },
        {
          "element": "Status",
          "props": {
            "label": "Channels created (including channel 0)",
            "value": "$view.channelCount"
          }
        },
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "createChannelFields",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    },
    "chooseBalance": {
      "requires": [
        "view"
      ],
      "element": "Screen",
      "props": {
        "title": "Pay-to-Play"
      },
      "children": [
        {
          "element": "Include",
          "call": {
            "namespace": "ui",
            "function": "balanceChooserFields",
            "args": {
              "view": "$view"
            }
          }
        }
      ]
    }
  }
}
